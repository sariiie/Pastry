@page "/our-story"
@rendermode InteractiveServer

<PageTitle>Our Story — Maison Fleurie</PageTitle>

<!-- Hero -->
<section class="hero about-hero">
    <div class="container hero-grid">
        <div class="hero-copy">
            <p class="eyebrow">The Story of Our Atelier</p>
            <h1>Craft in the soul, <span class="accent-italic">heart in the work</span></h1>
            <p class="hero-text">
                Trained by elite Meilleurs Ouvriers de France in the heart of Paris,
                founding chef Éléonore Martin opened Maison Fleurie with one vision:
                honouring seasonality and delicate precision.
            </p>
            <p class="hero-text">
                Every day, our small team of dedicated artisans nurtures a passion
                for refined craftsmanship. Everyone plays a part in favour of the
                delicate perfection of every individual piece leaving our worktable.
            </p>

            <div class="hero-stats">
                <div>
                    <p class="stat-name">Éléonore Martin</p>
                    <p class="stat-role">Chef Pâtissière</p>
                </div>
                <div>
                    <p class="stat-name">Atelier Roquette</p>
                    <p class="stat-role">Since 2017</p>
                </div>
            </div>
        </div>

        <div class="hero-media about-media">
            <div class="about-media-main"
                 style="background-image:url('https://loremflickr.com/700/760/pastrychef,portrait')"></div>
            <div class="about-media-overlap"
                 style="background-image:url('https://loremflickr.com/520/420/bakery,interior')"></div>
        </div>
    </div>
</section>

<!-- Traceability -->
<section class="section section-tinted">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Quality &amp; Ingredients</p>
            <h2>Exemplary Traceability</h2>
            <p class="section-subtext">A rare pledge of a committed craftsmanship, ensuring true material purity.</p>
        </div>

        <div class="trace-grid">
            <div class="trace-card">
                <span class="trace-number">I.</span>
                <h3>Beurre de Baratte AOP</h3>
                <p>Selected from Poitou-Charentes for its exceptional richness and depth of flavour.</p>
            </div>
            <div class="trace-card">
                <span class="trace-number">II.</span>
                <h3>Farine à la Pierre</h3>
                <p>Milled by our partner mill and stone-ground for an authentic texture and taste.</p>
            </div>
            <div class="trace-card">
                <span class="trace-number">III.</span>
                <h3>Tahitian Vanilla</h3>
                <p>Sourced directly from small producers for a pure, complex aromatic depth.</p>
            </div>
        </div>
    </div>
</section>

<!-- Boutique & Contact -->
<section class="section">
    <div class="container contact-grid">
        <div class="contact-info">
            <p class="eyebrow">Visit Us</p>
            <h2>The Boutique &amp; Atelier</h2>
            <p>
                Located in the heart of Paris's 11th arrondissement, our boutique
                welcomes you for an unforgettable tasting experience.
            </p>

            <ul class="contact-details">
                <li>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 21s7-7.1 7-12a7 7 0 10-14 0c0 4.9 7 12 7 12z" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.4"/></svg>
                    <span>24 Rue de la Roquette, 75011 Paris</span>
                </li>
                <li>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 5c0-.6.4-1 1-1h3l2 5-2 1.4A11 11 0 0013 15.4l1.4-2 5 2v3c0 .6-.4 1-1 1C10 19.4 4 13.4 4 5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                    <span>+33 1 42 00 18 27</span>
                </li>
                <li>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M4 6.5l8 6 8-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                    <span>contact&#64;maison-fleurie.fr</span>
                </li>
            </ul>

            <a class="map-thumb" href="https://maps.google.com" target="_blank" rel="noopener">
                <img src="https://placehold.co/560x220/f3e0d6/8a5a3b?font=playfair-display&text=24+Rue+de+la+Roquette%2C+Paris" alt="Map to Maison Fleurie, Paris" />
                <span class="map-thumb-btn">Open in Google Maps</span>
            </a>
        </div>

        <div class="contact-form-card">
            <h3>A Question, an Order?</h3>
            <p class="form-subtext">Our team would be delighted to assist you with your special request.</p>

            @if (submitted)
            {
                <div class="form-success">
                    <p><strong>Thank you, @(model.FullName.Split(' ')[0])!</strong></p>
                    <p>Your request has been received. We'll be in touch within one business day.</p>
                    <button class="btn btn-outline btn-sm" type="button" @onclick="ResetForm">Send another request</button>
                </div>
            }
            else
            {
                <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="form-row">
                        <div class="form-field">
                            <label for="fullName">Full Name</label>
                            <InputText id="fullName" @bind-Value="model.FullName" placeholder="Anna Martin" />
                        </div>
                        <div class="form-field">
                            <label for="email">Email Address</label>
                            <InputText id="email" @bind-Value="model.Email" placeholder="@("anna@example.com")" />
                        </div>
                    </div>

                    <div class="form-field">
                        <label for="subject">Subject</label>
                        <InputSelect id="subject" @bind-Value="model.Subject">
                            <option value="">Select the subject of your inquiry</option>
                            <option value="order">Special Order</option>
                            <option value="event">Event / Wedding Cake</option>
                            <option value="press">Press &amp; Media</option>
                            <option value="general">General Question</option>
                        </InputSelect>
                    </div>

                    <div class="form-field">
                        <label for="message">Your Message</label>
                        <InputTextArea id="message" rows="4" @bind-Value="model.Message" placeholder="Tell us how we can help you..." />
                    </div>

                    <ValidationSummary />

                    <button type="submit" class="btn btn-dark btn-block">Send Request</button>
                </EditForm>
            }
        </div>
    </div>
</section>

@code {
    private ContactModel model = new();
    private bool submitted = false;

    private void HandleSubmit()
    {
        submitted = true;
    }

    private void ResetForm()
    {
        model = new ContactModel();
        submitted = false;
    }

    public class ContactModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter your name.")]
        public string FullName { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter your email.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Please enter a valid email.")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please choose a subject.")]
        public string Subject { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter a message.")]
        public string Message { get; set; } = "";
    }
}
