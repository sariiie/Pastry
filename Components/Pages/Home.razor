@page "/"
@using MaisonFleurie.Components.Shared
<AuthGate @rendermode="InteractiveServer" />
@rendermode InteractiveServer

<PageTitle>Maison Fleurie — Elegance, Balance &amp; Artisanal Sweets</PageTitle>

<!-- Hero -->
<section class="hero">
    <div class="container hero-grid">
        <div class="hero-copy">
            <p class="eyebrow">Our Signature Pâtisserie</p>
            <h1>Elegance, balance <br />&amp;artisanal sweets</h1>
            <p class="hero-text">
                Every creation from Maison Fleurie is an ode to French delicacy —
                flawless formations, subtle floral infusions, and peak-freshness
                seasonal fruits.
            </p>
            <div class="hero-actions">
                <a class="btn btn-dark" href="/menu">Explore the Menu</a>
                <a class="btn btn-outline" href="/our-story">Our Story</a>
            </div>
        </div>

        <div class="hero-media">
            <div class="hero-media-main"
                 style="background-image:url('https://loremflickr.com/800/900/frenchpastry,tart')"></div>
            <div class="hero-media-side">
                <div class="hero-media-small"
                     style="background-image:url('https://loremflickr.com/500/420/macarons')"></div>
                <div class="hero-media-small"
                     style="background-image:url('https://loremflickr.com/500/420/croissant')"></div>
            </div>
        </div>
    </div>
</section>

<!-- Quote -->
<section class="quote-section">
    <div class="container quote-inner">
        <p class="quote-text">
            &ldquo;Pâtisserie is not merely technique; it is a language of love,
            delicate shapes, and textures that melt on the palate to suspend time.&rdquo;
        </p>
        <p class="quote-attribution">— Castellane Fleurie, Founder</p>
    </div>
</section>

<!-- Signature Creations -->
<section class="section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Signature Selection</p>
            <h2>Signature Creations</h2>
            <p class="section-subtext">Discover our iconic creations, the subtle inspiration of our exquisite workshop.</p>
        </div>

        <div class="product-grid">
            <ProductCard Title="L'Opaline Fleurie"
                         Badge="New"
                         Price="8,90€"
                         ImageUrl="https://loremflickr.com/500/380/pastry,cake"
                         Description="Soft, spun almond meringue and rosepetal cream, delicate and lightly sweetened."
                         CtaText="Add to Cart" />

            <ProductCard Title="Lemon & Lavender Tart"
                         Price="7,20€"
                         ImageUrl="https://loremflickr.com/500/380/lemontart"
                         Description="Crisp shortcrust pastry, lemon & lavender cream, subtly infused with organic provence honey."
                         CtaText="Add to Cart" />

            <ProductCard Title="Pure Chocolate-Pistachio"
                         Price="9,80€"
                         ImageUrl="https://loremflickr.com/500/380/chocolatedessert"
                         Description="Devoured Valrhona chocolate with 70% dark cocoa, an exceptional homemade Sicilian pistachio filling."
                         CtaText="Add to Cart" />
        </div>
    </div>
</section>

<!-- Gesture and material -->
<section class="section split-section">
    <div class="container split-grid">
        <div class="split-media"
             style="background-image:url('https://loremflickr.com/700/760/pastrychef,bakery')"></div>
        <div class="split-copy">
            <p class="eyebrow">Excellence &amp; Craftsmanship</p>
            <h2>The Gesture and the Material</h2>
            <p>
                Every morning, our hands purified and infused bread, feel enclosed
                by hand. Our ancient know-how enlivens the dough for the most
                exquisite viennoiseries.
            </p>
            <p>
                We collaborate exclusively with committed French producers to
                supply us Charentes-Poitou AOP butter, organic stone-ground flour
                and the finest fruits.
            </p>
        </div>
    </div>
</section>

<!-- Testimonials -->
<section class="section testimonial-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">The Experience</p>
            <h2>Kind Words from Our Patrons</h2>
        </div>

        <div class="testimonial-grid">
            <blockquote class="testimonial-card">
                <p>&ldquo;The best luminaries in Paris. Every bite of the Opaline croissant is a revelation of crispness and finesse.&rdquo;</p>
                <cite>— Isabelle L., Cordon Bleu Reportage</cite>
            </blockquote>
            <blockquote class="testimonial-card">
                <p>&ldquo;Their Saint-Honoré is an architectural marvel. The floral notes are balanced with extraordinary delicacy. Flawless.&rdquo;</p>
                <cite>— Marc Antoine D., Critique Gastronomique</cite>
            </blockquote>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta-section">
    <div class="container cta-inner">
        <h2>Plan Your Tasting</h2>
        <p>
            To guarantee a delicate experience and freshness, pre-order your favorite
            treats for handcrafted pickup.
        </p>
        <a class="btn btn-dark" href="/our-story">Book a Visit</a>
    </div>
</section>
