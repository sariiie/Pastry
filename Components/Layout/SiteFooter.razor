@namespace MaisonFleurie.Components.Layout

<footer class="site-footer">
    <div class="container footer-grid">
        <div class="footer-brand">
            <span class="logo-text logo-text-light">Maison Fleurie</span>
            <p>
                Because Fleurie is a luxury French boutique pâtisserie
                hand-crafting beautiful, delicate layered masterpieces with
                organic ingredients.
            </p>
            <div class="social-row">
                <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                </a>
                <a href="https://tiktok.com" target="_blank" rel="noopener" aria-label="TikTok">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M14 3v10.5a3.5 3.5 0 11-3-3.46" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M14 3a5 5 0 005 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </a>
                <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M14 9h2.5V6H14c-1.66 0-3 1.34-3 3v2H9v3h2v7h3v-7h2.2l.5-3H14V9.4c0-.25.15-.4.4-.4z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
                </a>
            </div>
        </div>

        <nav class="footer-col">
            <h4>Boutique</h4>
            <ul>
                <li><a href="/menu">Our Creations</a></li>
                <li><a href="/menu">Viennoiseries</a></li>
                <li><a href="/menu">Les Tartes</a></li>
                <li><a href="/menu">Macarons</a></li>
                <li><a href="/menu">Commandes Spéciales</a></li>
            </ul>
        </nav>

        <nav class="footer-col">
            <h4>Atelier</h4>
            <ul>
                <li><a href="/our-story">Notre Histoire</a></li>
                <li><a href="/our-story">Our Ingredients</a></li>
                <li><a href="/our-story">Savoir-Faire</a></li>
                <li><a href="/our-story">Careers</a></li>
                <li><a href="/our-story">Press &amp; Media</a></li>
            </ul>
        </nav>

        <div class="footer-col">
            <h4>Hours &amp; Address</h4>
            <p class="footer-text">Mon — Sat: 08:00 – 19:30<br />Sunday: 09:00 – 14:00<br />Lundi: Fermé</p>
            <p class="footer-text">24 Rue de la Roquette, 75011 Paris</p>
        </div>
    </div>

    <div class="container footer-bottom">
        <span>© @DateTime.Now.Year Maison Fleurie. Tous droits réservés.</span>
        <span class="footer-links">
            <a href="/our-story">Terms of Use</a>
            <a href="/our-story">Privacy Policy</a>
        </span>
    </div>
</footer>
