@namespace MaisonFleurie.Components.Layout

<header class="site-header">
    <div class="container header-inner">
        <a href="/" class="logo-block">
            <span class="logo-text">Maison Fleurie</span>
            <span class="logo-tagline">Artisan Pâtissier Français</span>
        </a>

        <nav class="main-nav" aria-label="Primary">
            <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="/menu">Menu</NavLink>
            <NavLink href="/our-story">Our Story</NavLink>
        </nav>

        <div class="header-actions">
            <button class="cart-btn" type="button" aria-label="View cart">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 8V6a6 6 0 1112 0v2M4 8h16l-1.2 12.1A2 2 0 0116.81 22H7.19a2 2 0 01-1.99-1.9L4 8z"
                          stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="cart-count">@CartCount</span>
            </button>
            <a href="/menu" class="btn btn-dark btn-sm">Order Online</a>
        </div>

        <button class="nav-toggle" type="button" aria-label="Toggle menu" @onclick="ToggleMenu">
            <span></span><span></span><span></span>
        </button>
    </div>

    @if (menuOpen)
    {
        <div class="mobile-nav">
            <NavLink href="/" Match="NavLinkMatch.All" @onclick="CloseMenu">Home</NavLink>
            <NavLink href="/menu" @onclick="CloseMenu">Menu</NavLink>
            <NavLink href="/our-story" @onclick="CloseMenu">Our Story</NavLink>
            <a href="/menu" class="btn btn-dark btn-sm">Order Online</a>
        </div>
    }
</header>

@code {
    private bool menuOpen = false;
    [Parameter] public int CartCount { get; set; } = 0;

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;
}
